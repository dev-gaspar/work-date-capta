{
  "name": "fechas-habiles-capta",
  "version": "1.0.0",
  "description": "API para calcular fechas hábiles en Colombia",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare-lambda": "node scripts/prepare-lambda.js",
    "build:lambda": "npm run build && npm run prepare-lambda",
    "deploy": "npm run build:lambda && cdk deploy",
    "deploy:watch": "npm run build:lambda && cdk deploy --hotswap"
  },
  "keywords": [
    "fechas",
    "habiles",
    "colombia",
    "api",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "dayjs": "^1.11.10",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.4.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}